# Sample environment overrides for the local Docker Compose stack.
#
# This file is intentionally focused on the local Compose/runtime path. It is
# not the full FireMUD environment contract for preview, Kubernetes, or other
# production-like deployments.

# Database
FIREMUD_POSTGRES_HOST=postgres
FIREMUD_POSTGRES_PORT=5432
FIREMUD_POSTGRES_DB=firemud
FIREMUD_POSTGRES_USER=firemud
FIREMUD_POSTGRES_PASSWORD=firemud

# Redis
FIREMUD_REDIS_HOST=redis-cache
FIREMUD_REDIS_PORT=6379
FIREMUD_REDIS_COORD_HOST=redis-coord
FIREMUD_REDIS_COORD_PORT=6379
FIREMUD_REDIS_CACHE_HOST=redis-cache
FIREMUD_REDIS_CACHE_PORT=6379

# Local auth/bootstrap secrets
# Replace these if you want local tokens or connect-context tokens to differ
# from the Compose defaults.
FIREMUD_AUTH_JWT_SECRET=dev-smoke-jwt-secret-dev-smoke-jwt-secret-1234567890
FIREMUD_GATEWAY_CONNECT_CONTEXT_JWT_SECRET=dev-smoke-jwt-secret-dev-smoke-jwt-secret-1234567890

# Spring profile
SPRING_PROFILES_ACTIVE=dev

# Observability
OTEL_ENDPOINT=
FLUENT_ELASTICSEARCH_HOST=elasticsearch
FLUENT_ELASTICSEARCH_PORT=9200

# Published asset store (MinIO in local Compose)
ASSET_STORE_ENDPOINT=http://minio:9000
ASSET_STORE_BUCKET=firemud-assets
ASSET_STORE_REGION=ap-southeast-2
ASSET_STORE_ACCESS_KEY=minio
ASSET_STORE_SECRET_KEY=minio123

# Optional local backup/object storage integration
PG_DUMP_BUCKET=
PG_DUMP_ENDPOINT=

# Optional TCP proxy local defaults
TCP_PROXY_DEFAULT_GAME_INSTANCE_ID=1
TCP_PROXY_DEFAULT_TENANT_ID=1

# Optional gRPC TLS file-path overrides.
# The normal local Compose path uses docker-compose.override.yml to force
# plaintext gRPC, so these are usually left alone. They remain here because
# the service configuration still supports the file-path contract.
FIREMUD_GRPC_CERT_CHAIN_PATH=certs/client.crt
FIREMUD_GRPC_PRIVATE_KEY_PATH=certs/client.key
FIREMUD_GRPC_CA_CERT_PATH=certs/ca.crt
