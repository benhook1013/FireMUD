{
  "title": "Player Experience",
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "type": "graph",
      "title": "Login Success Ratio",
      "targets": [
        {
          "expr": "sum by (scope) (rate(login_requests_total{outcome=\"success\"}[5m])) / sum by (scope) (rate(login_requests_total[5m]))",
          "legendFormat": "{{scope}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "graph",
      "title": "Login Success Ratio by Service",
      "targets": [
        {
          "expr": "sum by (scope, service) (rate(login_requests_total{outcome=\"success\"}[5m])) / sum by (scope, service) (rate(login_requests_total[5m]))",
          "legendFormat": "{{scope}} {{service}}",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "graph",
      "title": "Command Latency (p99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (scope, le, command) (rate(command_end_to_end_latency_ms_bucket[5m])))",
          "legendFormat": "{{scope}} {{command}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "graph",
      "title": "Command Latency (p99) by Service",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (scope, service, le, command) (rate(command_end_to_end_latency_ms_bucket[5m])))",
          "legendFormat": "{{scope}} {{service}} {{command}}",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "graph",
      "title": "Command Latency (p99) by Region",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (scope, le, command) (rate(command_end_to_end_latency_ms_bucket[5m])))",
          "legendFormat": "{{scope}} {{command}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "graph",
      "title": "Telnet/WebSocket Path Availability (5m Trend)",
      "targets": [
        {
          "expr": "sum by (scope, path) (rate(entrypath_connection_attempts_total{outcome=\"success\"}[5m])) / sum by (scope, path) (rate(entrypath_connection_attempts_total[5m]))",
          "legendFormat": "{{scope}} {{path}}",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "graph",
      "title": "Telnet/WebSocket Path Availability (1d SLO)",
      "targets": [
        {
          "expr": "sum by (scope, path) (increase(entrypath_connection_attempts_total{outcome=\"success\"}[1d])) / sum by (scope, path) (increase(entrypath_connection_attempts_total[1d]))",
          "legendFormat": "{{scope}} {{path}}",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "graph",
      "title": "Chat Delivery Latency (p99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (scope, le, channel_type) (rate(chat_delivery_latency_ms_bucket[5m])))",
          "legendFormat": "{{scope}} {{channel_type}}",
          "refId": "A"
        }
      ],
      "id": 4
    }
  ]
}
