{
  "title": "Backups",
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "type": "graph",
      "title": "Time Since Last Successful Backup (seconds)",
      "targets": [
        {
          "expr": "time() - backup_last_success_timestamp_seconds",
          "legendFormat": "since_last_backup",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "graph",
      "title": "Time Since Last Successful Verification (seconds)",
      "targets": [
        {
          "expr": "time() - backup_verify_last_success_timestamp_seconds",
          "legendFormat": "since_last_verify",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "graph",
      "title": "Time Since Last Successful Restore Drill (seconds)",
      "targets": [
        {
          "expr": "time() - backup_restore_drill_last_success_timestamp_seconds",
          "legendFormat": "{{environment}}",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "graph",
      "title": "Backup Artifact Lineage Invalid",
      "targets": [
        {
          "expr": "backup_artifact_lineage_invalid",
          "legendFormat": "{{environment}}",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "graph",
      "title": "Backup Artifact Restore Unreadable",
      "targets": [
        {
          "expr": "backup_artifact_restore_unreadable",
          "legendFormat": "{{environment}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "graph",
      "title": "Recovery Participant Blocked State",
      "targets": [
        {
          "expr": "recovery_participant_convergence_state{state=\"blocked\"}",
          "legendFormat": "{{environment}}/{{participant}}",
          "refId": "A"
        }
      ],
      "id": 6
    }
  ]
}
