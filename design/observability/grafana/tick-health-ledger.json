{
  "title": "Tick Health & Ledger",
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "type": "graph",
      "title": "Tick Status by Region",
      "targets": [
        {
          "expr": "tick_status == 1",
          "legendFormat": "{{scope_class}} = {{status}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "graph",
      "title": "Tick Execution Time Ratio (p99 / lock TTL)",
      "targets": [
        {
          "expr": "tick_execution_time_ms_p99 / tick_lock_ttl_ms",
          "legendFormat": "{{scope_class}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "graph",
      "title": "Retry and Command Queue Depth",
      "targets": [
        {
          "expr": "tick_retry_queue_depth",
          "legendFormat": "retry {{scope_class}}",
          "refId": "A"
        },
        {
          "expr": "tick_command_queue_depth",
          "legendFormat": "command {{scope_class}}",
          "refId": "B"
        }
      ],
      "id": 3
    },
    {
      "type": "graph",
      "title": "Tick Effect Ledger (Pending/Applied/Abandoned)",
      "targets": [
        {
          "expr": "tick_effects_pending_total",
          "legendFormat": "pending {{scope_class}}",
          "refId": "A"
        },
        {
          "expr": "tick_effects_applied_total",
          "legendFormat": "applied {{scope_class}}",
          "refId": "B"
        },
        {
          "expr": "sum by (scope_class) (tick_effects_abandoned_total)",
          "legendFormat": "abandoned {{scope_class}}",
          "refId": "C"
        }
      ],
      "id": 4
    },
    {
      "type": "graph",
      "title": "Non-RUNNING Regions (count)",
      "targets": [
        {
          "expr": "sum by (scope_class, status) (tick_status{status!=\"RUNNING\"} == 1)",
          "legendFormat": "{{scope_class}} = {{status}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "graph",
      "title": "Durable Commit vs Coordination Cleared",
      "targets": [
        {
          "expr": "rate(tick_durable_commit_total[5m])",
          "legendFormat": "durable {{scope_class}}",
          "refId": "A"
        },
        {
          "expr": "rate(tick_coordination_cleared_total[5m])",
          "legendFormat": "cleared {{scope_class}}",
          "refId": "B"
        }
      ],
      "id": 6
    },
    {
      "type": "graph",
      "title": "Tick Cleanup Lag (ms)",
      "targets": [
        {
          "expr": "tick_cleanup_lag_ms",
          "legendFormat": "{{scope_class}}",
          "refId": "A"
        }
      ],
      "id": 7
    }
  ]
}
