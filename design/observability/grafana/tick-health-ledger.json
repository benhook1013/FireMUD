{
  "title": "Tick Health & Ledger",
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "description": "Tick metrics are bounded scope-class rollups (region, game_instance, tenant, or cluster), not individual regions or other raw runtime identities. The mode-aware execution/TTL/ratio panels are target-only/currently unavailable until Game Session emits and proves the canonical families and bounded labels. Use control-plane and structured runtime evidence for exact diagnosis.",
  "panels": [
    {
      "type": "graph",
      "title": "Tick Status by Scope Class",
      "targets": [
        {
          "expr": "tick_status{scope_class=~\".+\"} == 1",
          "legendFormat": "scope bucket {{scope_class}} = {{status}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "graph",
      "title": "Tick Execution Time Ratio (p99 / mode-specific lock TTL)",
      "targets": [
        {
          "expr": "(tick_execution_time_ms_p99{scope_class=~\".+\",tick_mode=\"normal\"} / on (scope_class) tick_lock_ttl_ms{scope_class=~\".+\"}) or (tick_execution_time_ms_p99{scope_class=~\".+\",tick_mode=\"solo\"} / on (scope_class) solo_lock_ttl_ms{scope_class=~\".+\"})",
          "legendFormat": "scope bucket {{scope_class}} ({{tick_mode}})",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "graph",
      "title": "Retry and Command Queue Depth",
      "targets": [
        {
          "expr": "tick_retry_queue_depth{scope_class=~\".+\"}",
          "legendFormat": "retry (scope bucket {{scope_class}})",
          "refId": "A"
        },
        {
          "expr": "tick_command_queue_depth{scope_class=~\".+\"}",
          "legendFormat": "command (scope bucket {{scope_class}})",
          "refId": "B"
        }
      ],
      "id": 3
    },
    {
      "type": "graph",
      "title": "Tick Effect Ledger (Pending/Applied/Abandoned)",
      "targets": [
        {
          "expr": "tick_effects_pending_total{scope_class=~\".+\"}",
          "legendFormat": "pending (scope bucket {{scope_class}})",
          "refId": "A"
        },
        {
          "expr": "tick_effects_applied_total{scope_class=~\".+\"}",
          "legendFormat": "applied (scope bucket {{scope_class}})",
          "refId": "B"
        },
        {
          "expr": "sum by (scope_class) (tick_effects_abandoned_total{scope_class=~\".+\"})",
          "legendFormat": "abandoned (scope bucket {{scope_class}})",
          "refId": "C"
        }
      ],
      "id": 4
    },
    {
      "type": "graph",
      "title": "Non-RUNNING Scope Classes (count)",
      "targets": [
        {
          "expr": "sum by (scope_class, status) (tick_status{scope_class=~\".+\",status!=\"RUNNING\"} == 1)",
          "legendFormat": "scope bucket {{scope_class}} = {{status}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "graph",
      "title": "Durable Commit vs Coordination Cleared",
      "targets": [
        {
          "expr": "rate(tick_durable_commit_total{scope_class=~\".+\"}[5m])",
          "legendFormat": "durable (scope bucket {{scope_class}})",
          "refId": "A"
        },
        {
          "expr": "rate(tick_coordination_cleared_total{scope_class=~\".+\"}[5m])",
          "legendFormat": "cleared (scope bucket {{scope_class}})",
          "refId": "B"
        }
      ],
      "id": 6
    },
    {
      "type": "graph",
      "title": "Tick Cleanup Lag (ms)",
      "targets": [
        {
          "expr": "tick_cleanup_lag_ms{scope_class=~\".+\"}",
          "legendFormat": "scope bucket {{scope_class}}",
          "refId": "A"
        }
      ],
      "id": 7
    }
  ]
}
