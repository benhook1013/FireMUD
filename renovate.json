{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "timezone": "Pacific/Auckland",
  "baseBranchPatterns": [
    "develop"
  ],
  "labels": [
    "dependencies"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "gradle",
    "helmv3",
    "kubernetes",
    "kustomize",
    "nodenv",
    "npm",
    "pip_requirements",
    "pyenv",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/workflow-tool-versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate-version: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n(?:# renovate-image:[^\\n]+\\n)?[A-Z][A-Z0-9_]*_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/workflow-tool-versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate-image: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\n[A-Z][A-Z0-9_]*_VERSION=(?<currentValue>\\S+)\\n(?:[A-Z][A-Z0-9_]*=[^\\n]+\\n)*?[A-Z][A-Z0-9_]*_DIGEST=(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "versioningTemplate": "docker"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Keep the Velero CLI, image authority, and evidence-gated production projection in one update",
      "matchManagers": [
        "custom.regex",
        "kubernetes"
      ],
      "matchPackageNames": [
        "vmware-tanzu/velero",
        "velero/velero"
      ],
      "groupName": "velero tool and image"
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "gradle non-major updates",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm non-major updates"
    },
    {
      "description": "Keep canonical Node and Python runtime majors",
      "matchManagers": [
        "nodenv",
        "pyenv"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github actions non-major updates",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Deployment image digests are owned by the staged promotion workflow",
      "matchManagers": [
        "kubernetes",
        "kustomize"
      ],
      "matchFileNames": [
        "k8s/overlays/stage/kustomization.yaml",
        "k8s/overlays/prod/kustomization.yaml"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile",
        "helmv3",
        "kubernetes",
        "kustomize"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "infrastructure non-major updates",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Production Velero image changes require promotion evidence",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "k8s/velero/verify-backups-cronjob.yaml"
      ],
      "matchPackageNames": [
        "velero/velero"
      ],
      "pinDigests": false,
      "automerge": false,
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": false
  }
}
