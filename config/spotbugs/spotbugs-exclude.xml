<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude all generated sources -->
    <Match>
        <Source name=".*[\\/]build[\\/]generated[\\/].*" />
    </Match>
    
    <!-- Exclude all protobuf-generated classes in versioned packages (v1, v2, v3, ...) -->
    <Match>
        <Package name="~.*\\.v[0-9]+" />
        <Bug pattern=".*" />
    </Match>
</FindBugsFilter>
