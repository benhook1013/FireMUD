<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude all generated sources -->
    <Match>
        <Source name=".*[\\/]build[\\/]generated[\\/].*" />
    </Match>
    <Match>
        <Source name=".*[\\/]build[\\/]generated-src[\\/].*" />
    </Match>
    
    <!-- Exclude all protobuf-generated classes in versioned packages -->
    <Match>
        <Class name="~net\\.firedevops\\.firemud\\.account\\.v1\\..*" />
    </Match>
    <Match>
        <Class name="~net\\.firedevops\\.firemud\\.entitymanagement\\.v1\\..*" />
    </Match>
    <Match>
        <Class name="~net\\.firedevops\\.firemud\\.gamesession\\.v1\\..*" />
    </Match>
    <Match>
        <Class name="~net\\.firedevops\\.firemud\\.socialgroups\\.v1\\..*" />
    </Match>

    <!-- Exclude generated jOOQ DSL classes -->
    <Match>
        <Package name="~net\\.firedevops\\.firemud\\..*\\.jooq(\\..*)?" />
    </Match>
</FindBugsFilter>
