    "firemud.command-capabilities.presence-enabled": {
      "group": "commandCapabilities.availability",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": true
    },
    "firemud.command-capabilities.inventory-enabled": {
      "group": "commandCapabilities.availability",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": true
    },
    "firemud.command-capabilities.command-history-enabled": {
      "group": "commandCapabilities.availability",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": true
    },
    "firemud.movement.post-move-look-enabled": {
      "group": "movement.postMoveView",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable within operator-enforced caps",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": true
    },
    "firemud.world-topology.scope-model": {
      "group": "worldTopology.scopeModel",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": "MAP_ONLY"
    },
    "firemud.world-topology.regions-enabled": {
      "group": "worldTopology.regionBehavior",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable",
