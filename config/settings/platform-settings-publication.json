{
  "schemaVersion": "1",
  "description": "Canonical publication metadata for the surfaced pre-06 FireMUD platform settings domains. Spring metadata remains the source for key names, descriptions, defaults, and enum hints; this file adds publication-specific ownership and UX fields so one generated JSON schema and Markdown reference can serve operator/admin consumers.",
  "domains": [
    {
      "name": "communication",
      "keyPrefix": "firemud.communication",
      "service": "game-logic-service",
      "owner": "game-logic-service communication behavior defaults",
      "description": "Built-in communication behavior defaults surfaced by Game Logic; player availability is controlled by standard command capabilities.",
      "referenceDoc": "design/architecture/microservices/game-logic-service/configuration.md",
      "runtimeSurface": "/actuator/settings/effective/communication",
      "properties": [
        "firemud.communication.max-message-length",
        "firemud.communication.whisper-observer-metadata-enabled"
      ]
    },
    {
      "name": "presentation",
      "keyPrefix": "firemud.presentation",
      "service": "game-session-service",
      "owner": "game-session-service operator defaults",
      "description": "Player-facing text presentation defaults surfaced by Game Session.",
      "referenceDoc": "design/architecture/microservices/game-session-service/configuration.md",
      "runtimeSurface": "/actuator/settings/effective",
      "properties": [
        "firemud.presentation.default-locale-tag",
        "firemud.presentation.default-color-mode",
        "firemud.presentation.brief-enabled-by-default",
        "firemud.presentation.prompt.enabled",
        "firemud.presentation.prompt.emit-after-reconnect-restore",
        "firemud.presentation.prompt.coalesce-window-ms"
      ]
    },
    {
      "name": "reconnection",
      "keyPrefix": "firemud.reconnection",
      "service": "game-session-service",
      "owner": "game-session-service operator defaults",
      "description": "Reconnect resume policy and bounded semantic reconnect-context retention/resource defaults surfaced by Game Session; retention never grants resume or replay authority.",
      "referenceDoc": "design/architecture/microservices/game-session-service/configuration.md",
      "runtimeSurface": "/actuator/settings/effective",
      "properties": [
        "firemud.reconnection.policy.resume-window-ms",
        "firemud.reconnection.policy.stale-resume-falls-through-to-fresh-entry",
        "firemud.reconnection.buffer.ttl-ms",
        "firemud.reconnection.buffer.max-entries",
        "firemud.reconnection.buffer.min-messages",
        "firemud.reconnection.buffer.min-lines",
        "firemud.reconnection.buffer.soft-max-bytes",
        "firemud.reconnection.buffer.hard-max-bytes"
      ]
    },
    {
      "name": "commandHistory",
      "keyPrefix": "firemud.command-history",
      "service": "game-session-service",
      "owner": "game-session-service operator defaults",
      "description": "Bounded accepted player-command history defaults surfaced by Game Session.",
      "referenceDoc": "design/architecture/microservices/game-session-service/configuration.md",
      "runtimeSurface": "/actuator/settings/effective",
      "properties": [
        "firemud.command-history.max-entries"
      ]
    },
    {
      "name": "commandCapabilities",
      "keyPrefix": "firemud.command-capabilities",
      "service": "common-platform-core",
      "owner": "common-platform-core shared player-command policy",
      "description": "Tenant/game-controlled availability for standard player command families.",
      "referenceDoc": "design/architecture/system-architecture-player-command-model.md",
      "runtimeSurface": "/actuator/settings/effective",
      "properties": [
        "firemud.command-capabilities.social-enabled",
        "firemud.command-capabilities.presence-enabled",
        "firemud.command-capabilities.inventory-enabled",
        "firemud.command-capabilities.command-history-enabled"
      ]
    },
    {
      "name": "movement",
      "keyPrefix": "firemud.movement",
      "service": "game-session-service",
      "owner": "game-session-service operator defaults",
      "description": "Movement presentation defaults surfaced by Game Session.",
      "referenceDoc": "design/architecture/microservices/game-session-service/configuration.md",
      "runtimeSurface": "/actuator/settings/effective",
      "properties": [
        "firemud.movement.post-move-look-enabled"
      ]
    },
    {
      "name": "worldTopology",
      "keyPrefix": "firemud.world-topology",
      "service": "game-session-service",
      "owner": "game-session-service operator defaults",
      "description": "Topology behavior defaults surfaced by Game Session for later scope-sensitive world behavior.",
      "referenceDoc": "design/architecture/microservices/game-session-service/configuration.md",
      "runtimeSurface": "/actuator/settings/effective",
      "properties": [
        "firemud.world-topology.scope-model",
        "firemud.world-topology.regions-enabled"
      ]
    }
  ],
  "properties": {
    "firemud.communication.max-message-length": {
      "group": "communication.behavior",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable within operator-enforced caps",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": 512,
      "constraints": "integer >= 1"
    },
    "firemud.communication.whisper-observer-metadata-enabled": {
      "group": "communication.behavior",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable within operator-enforced caps",
      "hotReloadable": false,
      "advanced": true,
      "exampleValue": true
    },
    "firemud.presentation.default-locale-tag": {
      "group": "transcript.rendering",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": "en-NZ",
      "constraints": "Non-blank IETF BCP 47 locale tag"
    },
    "firemud.presentation.default-color-mode": {
      "group": "transcript.rendering",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": "NONE"
    },
    "firemud.presentation.brief-enabled-by-default": {
      "group": "transcript.rendering",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": false
    },
    "firemud.presentation.prompt.enabled": {
      "group": "prompts.transportPresentation",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": true
    },
    "firemud.presentation.prompt.emit-after-reconnect-restore": {
      "group": "prompts.transportPresentation",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": true
    },
    "firemud.presentation.prompt.coalesce-window-ms": {
      "group": "prompts.coalescing",
      "scope": "operator-only",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": true,
      "exampleValue": 150,
      "constraints": "integer >= 1 ms"
    },
    "firemud.reconnection.policy.resume-window-ms": {
      "group": "reconnection.policy",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": 180000,
      "constraints": "integer >= 1 ms"
    },
    "firemud.reconnection.policy.stale-resume-falls-through-to-fresh-entry": {
      "group": "reconnection.policy",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": true
    },
    "firemud.reconnection.buffer.ttl-ms": {
      "group": "reconnection.buffer",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": true,
      "exampleValue": 1800000,
      "constraints": "integer >= 0 ms; 0 retains bounded semantic reconnect context until size eviction; retention never grants resume or replay authority"
    },
    "firemud.reconnection.buffer.max-entries": {
      "group": "reconnection.buffer",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": true,
      "exampleValue": 256,
      "constraints": "integer >= 1 complete persisted entries"
    },
    "firemud.reconnection.buffer.min-messages": {
      "group": "reconnection.buffer",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": true,
      "exampleValue": 8,
      "constraints": "integer >= 1; best-effort floor subordinate to the absolute hard byte ceiling"
    },
    "firemud.reconnection.buffer.min-lines": {
      "group": "reconnection.buffer",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": true,
      "exampleValue": 24,
      "constraints": "integer >= 1; best-effort floor subordinate to the absolute hard byte ceiling"
    },
    "firemud.reconnection.buffer.soft-max-bytes": {
      "group": "reconnection.buffer",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": true,
      "exampleValue": 16384,
      "constraints": "integer >= 1 bytes; subordinate best-effort preference; effective softMaxBytes <= hardMaxBytes"
    },
    "firemud.reconnection.buffer.hard-max-bytes": {
      "group": "reconnection.buffer",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable",
      "hotReloadable": false,
      "advanced": true,
      "exampleValue": 65536,
      "constraints": "integer >= 1 bytes; absolute bound for the complete scope-bound persisted envelope; oversized entries must be omitted or represented by a bounded marker and never partially truncated; effective hardMaxBytes >= softMaxBytes; current runtime oversized-single-entry enforcement remains an implementation/proof gap"
    },
    "firemud.command-history.max-entries": {
      "group": "commandHistory.retention",
      "scope": "tenant/game-configurable",
      "futureScope": "tenant/game-configurable within platform bounds",
      "hotReloadable": false,
      "advanced": false,
      "exampleValue": 10,
      "constraints": "integer from 1 to 20"
    },
    "firemud.command-capabilities.social-enabled": {
