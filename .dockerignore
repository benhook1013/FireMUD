# Intentionally minimal: service image builds use service-local jar contexts and
# only copy a small allowlisted helper set from repo_root.
*

!docker/
docker/*
!docker/start-service.sh
!docker/pg-dump-cron.Dockerfile
!docker/pg-dump-cron.crontab

!dev-tools/
dev-tools/*
!dev-tools/wait-for-it.sh
!dev-tools/backups/
dev-tools/backups/*
!dev-tools/backups/pg-dump-rotate.sh
